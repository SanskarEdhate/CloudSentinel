# Replace all placeholders locally; never commit the resulting .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
PORT=5000
# Local MySQL defaults; use the actual host and port if your database is remote.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloudsentinel
DB_USER=cloudsentinel
DB_PASSWORD=replace-with-your-database-user-password
# Optional NVD API key; improves rate limits. Never commit this value.
# NVD_API_KEY=
# Optional local cache path for the MITRE ATT&CK STIX feed.
# ATTACK_CACHE_PATH=data_cache/enterprise-attack.json
# Optional path to a locally downloaded CIC-IDS2017 CSV.
# CICIDS_CSV_PATH=
# Initial administrator credentials; seed_admin.py will not overwrite an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
